{
  "name": "rrc",
  "author": "Alexander Danilov",
  "license": "MIT",
  "version": "0.23.4",
  "description": "Powerful data fetching and caching library for React, Redux and Zustand that supports normalization.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./redux": {
      "types": "./dist/redux/index.d.ts",
      "default": "./dist/redux/index.js"
    },
    "./zustand": {
      "types": "./dist/zustand/index.d.ts",
      "default": "./dist/zustand/index.js"
    },
    "./*": null
  },
  "sideEffects": false,
  "scripts": {
    "example": "(cd example && yarn && yarn release)",
    "example-dist": "(cd example && yarn) && yarn sync-example && (cd example && yarn release)",
    "sync-example": "rm -rf example/node_modules/rrc example/node_modules/.vite example/node_modules/.yarn-integrity && mkdir -p example/node_modules/rrc && cp -R dist package.json example/node_modules/rrc",
    "clean": "rm -rf dist",
    "lint": "yarn eslint .",
    "lint-fix": "yarn eslint --fix .",
    "build": "yarn lint && yarn build-lib && yarn size && yarn generate-docs && yarn benchmark",
    "size": "minified-size dist/*.js | grep 'total:' | sed -E 's/.*total: [^,]*, ([^,]*), ([^,]*), ([^,]*).*/<br\\/>minified: \\1<br\\/>gzipped: \\2<br\\/>brotlied: \\3/'",
    "test": "node node_modules/jest/bin/jest.js",
    "health-check": "(cd example && yarn) && yarn sync-example && (cd example && yarn build) && node --test scripts/health-check.mjs",
    "preminor-rc": "yarn build && npm version preminor --preid rc",
    "prepatch-rc": "yarn build && npm version prepatch --preid rc",
    "publish-rc": "npm publish --tag rc",
    "remove-rc": "npm version <same-version-without-rc>",
    "prepublishOnly": "yarn build && yarn test && yarn health-check",
    "generate-docs": "node --experimental-strip-types scripts/generate-docs.ts",
    "benchmark": "NODE_ENV=production node --expose-gc scripts/benchmark.mjs",
    "build-lib": "yarn clean && tsc -p tsconfig.build.json && tsc -p tsconfig.build.json --removeComments false --declaration --emitDeclarationOnly"
  },
  "peerDependencies": {
    "fast-deep-equal": "*",
    "react": ">=16.8",
    "react-redux": ">=7.1"
  },
  "peerDependenciesMeta": {
    "fast-deep-equal": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-redux": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/jest-dom": "6.1.4",
    "@testing-library/react": "14.0.0",
    "@types/jest": "29.5.1",
    "@types/node": "20.1.2",
    "@types/redux-logger": "3.0.9",
    "@typescript-eslint/eslint-plugin": "8.51.0",
    "@typescript-eslint/parser": "8.51.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "15.9.0",
    "jest": "29.5.0",
    "jest-environment-jsdom": "29.7.0",
    "jsdom": "20.0.3",
    "minified-size": "4.0.0",
    "prettier": "3.7.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-redux": "8.0.5",
    "react-router-dom": "6.18.0",
    "redux": "4.2.1",
    "redux-logger": "3.0.6",
    "ts-jest": "29.1.0",
    "typescript": "5.9.3"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "rrc",
    "react",
    "redux",
    "zustand",
    "cache",
    "query",
    "normalization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gentlee/rrc.git"
  }
}
